@model RaceDayMVC.Models.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                    <h3 class="font-weight-bold">
                        <span class="brand-red">CREATE</span> <span class="brand-green">EVENT</span>
                    </h3>
                </div>
                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Event Name</label>
                            <input asp-for="EventName" class="form-control" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-bold">Date</label>
                                <input asp-for="EventDate" class="form-control" type="date" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-bold">Start Time</label>
                                <input asp-for="StartTime" class="form-control" type="time" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Distance (km)</label>
                            <input asp-for="Distance" class="form-control" type="number" step="0.1" required />
                        </div>

                        <!-- For now, we hardcode Venue and Category to 1 since we haven't built those pages yet -->
                        <input type="hidden" asp-for="VenueId" value="1" />
                        <input type="hidden" asp-for="CategoryId" value="1" />

                        <button type="submit" class="btn btn-primary-custom w-100 py-2 mt-2">Create Event</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>