@model RaceDayMVC.Models.RegisterViewModel

@{
    ViewData["Title"] = "Sign Up";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                    <h3 class="font-weight-bold">
                        <span class="brand-red">SIGN</span> <span class="brand-green">UP</span>
                    </h3>
                    <p class="text-muted">Join the RaceDay community</p>
                </div>
                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Register" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-bold">First Name</label>
                                <input asp-for="FirstName" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-bold">Last Name</label>
                                <input asp-for="LastName" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Email Address</label>
                            <input asp-for="Email" class="form-control" type="email" required placeholder="name@example.com" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Password</label>
                            <input asp-for="Password" class="form-control" type="password" required placeholder="••••••••" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label font-weight-bold">I am registering as a:</label>
                            <select asp-for="Role" class="form-select" required>
                                <option value="">-- Select a Role --</option>
                                <option value="Participant">Participant (I want to run/walk)</option>
                                <option value="Organiser">Organiser (I want to create events)</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-secondary-custom w-100 py-2">Create Account</button>
                    </form>

                    <div class="text-center mt-3">
                        <p class="mb-0">Already have an account? <a asp-action="Login" class="text-danger font-weight-bold">Log in here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>