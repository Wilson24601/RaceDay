@model RaceDayMVC.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                    <h3 class="font-weight-bold">
                        <span class="brand-red">MY</span> <span class="brand-green">PROFILE</span>
                    </h3>
                    <p class="text-muted">Update your personal information</p>
                </div>
                <div class="card-body p-4">

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success">@ViewBag.Message</div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <!-- Important: enctype="multipart/form-data" is required for file uploads -->
                    <form asp-action="Profile" method="post" enctype="multipart/form-data">

                        <!-- Display Current Profile Picture -->
                        <div class="text-center mb-4">
                            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                            {
                                <img src="@Model.ProfilePictureUrl" alt="Profile Picture" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white shadow-sm" style="width: 120px; height: 120px; font-size: 3rem;">
                                    👤
                                </div>
                            }
                        </div>

                        <!-- Hidden fields to preserve data -->
                        <input type="hidden" asp-for="ProfilePictureUrl" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-bold">First Name</label>
                                <input asp-for="FirstName" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label font-weight-bold">Last Name</label>
                                <input asp-for="LastName" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Email Address</label>
                            <input asp-for="Email" class="form-control" readonly style="background-color: #e9ecef;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Phone Number</label>
                            <input asp-for="Phone" class="form-control" type="tel" placeholder="e.g. 082 123 4567" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label font-weight-bold">Update Profile Picture</label>
                            <input asp-for="ProfileImage" class="form-control" type="file" accept="image/*" />
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 py-2">Save Changes</button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>