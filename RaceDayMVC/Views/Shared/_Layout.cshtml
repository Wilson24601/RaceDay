<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-custom mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-red">RACE</span><span class="brand-green">DAY</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @* Role-Based Navigation *@
                        @if (Context.Session.GetString("UserRole") == "Organiser")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Events" asp-action="Index">My Events</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Events" asp-action="Create">Create Event</a></li>
                        }
                        else if (Context.Session.GetString("UserRole") == "Participant")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Events" asp-action="MyEnrolments">My Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Events" asp-action="MyResults">My Results</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark font-weight-bold me-2" asp-controller="Account" asp-action="Profile">My Profile</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-success font-weight-bold">Hello, @Context.Session.GetString("UserEmail")</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger ms-2" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary-custom me-2" asp-controller="Account" asp-action="Login">Log In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-secondary-custom" asp-controller="Account" asp-action="Register">Sign Up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>