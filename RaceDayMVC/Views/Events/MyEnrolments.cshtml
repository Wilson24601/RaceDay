@model IEnumerable<RaceDayMVC.Models.MyEnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h2 class="fw-bold mb-0">
            <span class="brand-red">MY</span> <span class="brand-green">ENROLMENTS</span>
        </h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Find More Races</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card event-card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="card-title fw-bold text-dark mb-0">@item.EventName</h4>

                                <!-- Color-coded status badge -->
                                @if (item.EnrolmentStatus == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.EnrolmentStatus</span>
                                }
                            </div>

                            <p class="text-muted mb-1"> @item.EventDate.ToString("dd MMM yyyy")</p>
                            <p class="text-muted mb-3"> @item.VenueName</p>

                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId" class="btn btn-secondary-custom w-100">View Event</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <h4>You haven't enrolled in any events yet.</h4>
            <p class="mb-0">Head over to the home page to find your next race!</p>
        </div>
    }
</div>